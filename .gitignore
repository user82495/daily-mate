# Lichess open puzzle database — ~900MB uncompressed, regenerate with:
#   curl -L -O https://database.lichess.org/lichess_db_puzzle.csv.zst
# Never commit it. puzzles.js (the generated subset) IS committed.
lichess_db_puzzle.csv
lichess_db_puzzle.csv.zst

# Lichess monthly game dumps, for scripts/build_games.py and build_evals.py.
# Tens of gigabytes each. The generated data/games.json and data/evals.json
# are what get committed, never the source.
lichess_db_standard_rated_*.pgn
lichess_db_standard_rated_*.pgn.zst
*.pgn.zst

node_modules/
.DS_Store

# Local dev-server config for Claude Code, not part of the project
.claude/launch.json

# Rendered shorts — regenerate with:  python3 puzzleshorts.py
videos/

# Netlify's local build/deploy state
.netlify/

# Local-only analytics dashboard. Holds the Supabase service role key in
# plain text, so it must never be committed and must never be deployed.
# The folder rule covers everything inside it; the config line below is
# belt and braces, so a moved or copied config still cannot slip through.
local-dashboard/
**/local-dashboard-config.js

# Python bytecode from the data build scripts
__pycache__/
*.pyc

# Review pages from scripts/review_evals.py — regenerate, never commit.
evals-review.html
